<Window x:Class="StickerBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StickerBoard"
        Title="StickerBoard" Icon="Assets/app.ico" Width="520" Height="420" MinWidth="180" MinHeight="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        AllowDrop="True" UseLayoutRounding="True"
        KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown" DragOver="Window_DragOver" Drop="Window_Drop"
        MouseEnter="Window_MouseHover" MouseLeave="Window_MouseHover">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="10" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim slider for the title bar: filled track + round knob -->
        <Style x:Key="TrackPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackPart}" Background="#CCFFFFFF"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackPart}" Background="#40FFFFFF"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob" Width="10" Height="10" Fill="White"
                                                     Stroke="#66000000" StrokeThickness="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Width" Value="12"/>
                                                    <Setter TargetName="Knob" Property="Height" Value="12"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="8" BorderThickness="1"
            ContextMenuOpening="Root_ContextMenuOpening"
            PreviewMouseRightButtonDown="Root_PreviewMouseRightButtonDown">
        <Border.ContextMenu>
            <ContextMenu/>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Background="#01000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <DockPanel x:Name="TitleContent" Margin="9,0,3,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BarButton}" Content="&#xE710;"
                                ToolTip="{local:Tr tip.newNote}" Click="AddNote_Click"/>
                        <Button x:Name="PenButton" Style="{StaticResource BarButton}" Content="&#xE70F;"
                                ToolTip="{local:Tr tip.pen}" Click="Pen_Click"/>
                        <Button x:Name="LockButton" Style="{StaticResource BarButton}" Content="&#xE785;" Click="Lock_Click"/>
                        <Button x:Name="PinButton" Style="{StaticResource BarButton}" Content="&#xE718;" Click="Pin_Click"/>
                        <Button Style="{StaticResource BarButton}" Content="&#xE921;" ToolTip="{local:Tr tip.minimize}" Click="Minimize_Click"/>
                        <Button x:Name="MaxButton" Style="{StaticResource BarButton}" Content="&#xE922;"
                                ToolTip="{local:Tr tip.maximize}" Click="Maximize_Click"/>
                        <Button Style="{StaticResource BarButton}" Content="&#xE8BB;" ToolTip="{local:Tr tip.close}" Click="Close_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="OpacityPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,8,0" Background="#01000000"
                                ToolTip="{local:Tr tip.opacity}">
                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#AAFFFFFF"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="OpacitySlider" Style="{StaticResource BarSlider}" Width="72" Height="18"
                                Minimum="0" Maximum="0.95" LargeChange="0.1" SmallChange="0.05"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                    </StackPanel>
                    <TextBlock Text="StickerBoard" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>

            <Grid Grid.Row="1" ClipToBounds="True">
                <!-- Empty-board hint: small, bottom-right (clear of the resize grip) -->
                <TextBlock x:Name="HintText" IsHitTestVisible="False" TextAlignment="Right"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,10"
                           Foreground="#55FFFFFF" FontSize="11" LineHeight="17"/>
                <Canvas x:Name="Board" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                        MouseLeftButtonDown="Board_MouseLeftButtonDown"/>
                <!-- Ink layer: takes input only in pen mode; otherwise clicks pass through -->
                <InkCanvas x:Name="Ink" Background="Transparent" IsHitTestVisible="False"
                           EditingMode="Ink" EditingModeInverted="EraseByStroke" Focusable="False"/>
                <Viewbox StretchDirection="DownOnly" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                         Margin="8,0,8,8">
                    <Border x:Name="PenToolbar" Visibility="Collapsed" CornerRadius="16" Padding="6,4"
                            Background="#EE222328" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <StackPanel x:Name="PenTools" Orientation="Horizontal"/>
                    </Border>
                </Viewbox>
            </Grid>

            <!-- Window resize grip: dragging it triggers native Windows resizing -->
            <Grid x:Name="WindowGrip" Grid.Row="1" Width="18" Height="18" Margin="0,0,2,2"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#01000000"
                  Cursor="SizeNWSE" WindowChrome.ResizeGripDirection="BottomRight" Opacity="0"
                  ToolTip="{local:Tr tip.resizeWindow}">
                <Path Data="M 15,5 L 5,15 M 15,9 L 9,15 M 15,13 L 13,15" Stroke="#CCFFFFFF" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
        </Grid>
    </Border>
</Window>
